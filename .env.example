SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://saitama_app:your_password@localhost:5432/saitama_help
# Cookie に Secure 属性を付ける。HTTPS で配信する本番（EC2）では true、開発の http://localhost では false（省略時 false）
# SESSION_COOKIE_SECURE=false
# CSRF 検証で HTTPS のとき Referer の同一オリジンを検査する（省略時 true）。
# Nginx の背後でオリジンが食い違い、フォーム送信が全部弾かれるときだけ false にする
# WTF_CSRF_SSL_STRICT=true
# ログインの一時ロック：連続失敗がこの回数（1 以上）に達したら、この分数（1 以上）ログイン不可にする（省略時 5 回・15 分。整数以外・範囲外は起動時エラー）
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# Nginx など前段のリバースプロキシの段数（0 以上の整数。省略時 0 = ProxyFix を使わない）。
# EC2（Nginx 1 段）では 1。Nginx が Host / X-Forwarded-Proto を渡し、gunicorn が 127.0.0.1 かソケットだけで待ち受ける場合のみ設定する
# PROXY_FIX_HOPS=0
# pytest 用の DB（開発 DB とは別にすること）
TEST_DATABASE_URL=postgresql+psycopg://saitama_app:your_password@localhost:5432/saitama_help_test
# AI分析「要人間チェック（低信頼度）」のしきい値（0〜1、省略時 0.7）
AI_LOW_CONFIDENCE_THRESHOLD=0.7
# AI緊急度の再判定：未対応のまま報告からこの時間たった報告を再判定する（省略時 12）
# AI_REJUDGE_HOURS=12

# AI（Gemini）。GEMINI_API_KEY を入れるだけで有効になる。空ならキーワード判定（rule_based）
GEMINI_API_KEY=
# 以下は省略可（省略時の値）
# AI_PROVIDER=gemini              # rule_based にすると Gemini を使わない
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_MS=20000
# GEMINI_MAX_RETRIES=2
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_THINKING_LEVEL=          # 対応モデルのみ minimal / low など

# 地図表示（Google Maps JavaScript API）。空なら従来の地図画像を表示する
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID   # 本番は Google Cloud で作成したマップ ID

# 住所 → 緯度・経度の検索（GPS 情報がない報告の位置）。省略時は国土地理院の住所検索 API。空にすると検索しない
# GEOCODER_URL=https://msearch.gsi.go.jp/address-search/AddressSearch
# 緯度・経度 → 住所（GPS の位置の住所。職員が発生場所と照合する）。省略時は国土地理院の逆ジオコーダー。空にすると求めない
# REVERSE_GEOCODER_URL=https://mreversegeocoder.gsi.go.jp/reverse-geocoder/LonLatToAddress
# GEOCODER_TIMEOUT=5

# 写真・アイコンの保存先（省略時は instance/uploads）
# UPLOAD_FOLDER=
